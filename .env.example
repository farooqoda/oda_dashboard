# Copy to .env and fill in. Vite only exposes variables prefixed with VITE_.
# Both values are safe to ship in a browser bundle ONLY because Supabase Row
# Level Security is enabled — the anon key may SELECT gab_leads / gab_activity
# and UPDATE gab_leads, and nothing else. Never put a service-role key here.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
